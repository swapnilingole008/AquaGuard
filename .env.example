# =================================================================
# AgriGuard - AI-Powered Climate-Smart Farming Platform
# Environment Variables Configuration
# =================================================================

# 1. Google Gemini API Key & Model
# Used by the Gemini Advisory Engine to supplement ML predictions with
# deep agronomic explanations, disease treatments, and Kisan Mitra chat.
# Recommended models: 'gemini-2.0-flash' (fastest, state-of-the-art) or 'gemini-1.5-flash'
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Meteorological Weather API Key
# Used to fetch live local temperatures, precipitation, wind, and forecasts.
# Supported providers: 'openweathermap' or 'weatherapi'
# - OpenWeatherMap: https://openweathermap.org/api (free tier supported)
# - WeatherAPI: https://www.weatherapi.com/
WEATHER_API_KEY=
WEATHER_PROVIDER=openweathermap

# 3. Server Configuration
HOST=127.0.0.1
PORT=8000
